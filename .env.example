# ---------------------------------------------------------------------------
# VlogBuddy configuration
#
# Copy to `.env` and adjust. VlogBuddy does NOT ship a reverse proxy:
# point your existing one (Caddy / nginx / Traefik) at WEB_PORT and S3_PORT.
# See README.md for sample proxy configuration.
# ---------------------------------------------------------------------------

# --- Public URLs (as seen from your friends' browsers) ----------------------
# Public origin of the app itself. Used to build share links, set cookies and
# lock down Socket.IO / CORS origins.
PUBLIC_BASE_URL=https://vlog.example.com

# Public origin of the object storage endpoint. The browser talks to this
# directly for presigned uploads/downloads, so it MUST be reachable publicly
# and allow large request bodies.
PUBLIC_STORAGE_URL=https://vlog-storage.example.com

# Browser Origin allowed to talk to MinIO (uploads) and Socket.IO.
# Leave empty to use PUBLIC_BASE_URL (correct behind a reverse-proxy domain).
# Set to * if friends open the app by IP/port with no domain — otherwise the
# Origin (http://192.168.x.x:3000) won't match and file uploads fail CORS.
# Do not use * on the public internet.
CORS_ALLOW_ORIGIN=

# --- Host ports (what your reverse proxy forwards to) -----------------------
WEB_PORT=3000
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- Database ---------------------------------------------------------------
# Under Docker Compose these three are the only values that matter — the
# connection URL is assembled from them, so the password lives in one place.
POSTGRES_USER=vlogbuddy
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=vlogbuddy

# ONLY used when running the app outside Docker (`pnpm dev`, `pnpm db:migrate`).
# Compose ignores this and builds its own URL from the values above.
DATABASE_URL=postgres://vlogbuddy:change-me-postgres@localhost:5432/vlogbuddy

# --- Object storage (MinIO / any S3-compatible) -----------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=vlogbuddy
S3_ACCESS_KEY=vlogbuddy
S3_SECRET_KEY=change-me-minio
# Presigned URL lifetime in seconds.
S3_PRESIGN_EXPIRY=3600

# --- Security ---------------------------------------------------------------
# Signs member session cookies, and encrypts stored Immich API keys.
# Generate with: openssl rand -hex 32
# Both the web and worker services need the same value.
SESSION_SECRET=change-me-with-openssl-rand-hex-32

# --- Admin -------------------------------------------------------------------
# Guards /admin (HTTP Basic Auth) and starting new vlogs. Everything a guest
# touches — share links, the cutting room, the finished film — stays open.
# Leave ADMIN_PASSWORD empty and the admin area is sealed off entirely, which
# also means nobody can create a vlog.
# Basic Auth sends credentials base64-encoded, so serve this over HTTPS.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Uploads ----------------------------------------------------------------
# Max single-file upload size in megabytes.
MAX_UPLOAD_MB=2048

# --- Music ------------------------------------------------------------------
# Extract audio from YouTube links with yt-dlp so the chosen track can be muxed
# into the final render.
#
# WARNING: downloading audio from YouTube violates YouTube's Terms of Service
# and the result is not redistributable. This is provided for private,
# self-hosted, personal use only and is DISABLED by default. Enable at your own
# risk and legal responsibility. With this off, music links remain available for
# discovery/voting/timeline placement and the editor supplies an uploaded audio
# file for the actual export.
ENABLE_YT_AUDIO=false

# --- Rendering --------------------------------------------------------------
# Concurrent render jobs. Raise only if the host has the CPU for it.
RENDER_CONCURRENCY=1
# Output resolution of the final vlog (height in px), e.g. 1080 or 2160.
RENDER_HEIGHT=1080
RENDER_FPS=30
# Cores the renderer may use; 0 means all of them. Set it to 1 or 2 on a box
# that has other jobs to do — renders take longer and the machine stays usable.
RENDER_THREADS=0
